<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    class="sapUiSizeCompact"
>
    <f:SimpleForm
        editable="true"
        layout="ColumnLayout"
    >
        <Label text="{i18n>dpId}" />
        <ComboBox
            selectedKey="{viewModel>/DPID}"
            items="{/F4_UploadTypeSet}"
            editable="false"
        >
            <core:Item
                key="{UPLOAD_TYPE}"
                text="{UPLOAD_TYPE_TEXT}"
            />
        </ComboBox>
        <Label text="{i18n>clientID}" />
        <ComboBox
            selectedKey="{viewModel>/ClientID}"
            items="{/F4_UploadTypeSet}"
            editable="false"
        >
            <core:Item
                key="{UPLOAD_TYPE}"
                text="{UPLOAD_TYPE_TEXT}"
            />
        </ComboBox>
        <Label
            text="{i18n>nameOfTheClaimant}"
            required="false"
        />
        <Input
            value="{viewModel>/nameOfClaimant}"
            editable="false"
        />
        <Label
            text="{i18n>authorisationName}"
            required="true"
        />
        <Input
            value="{viewModel>/AuthorizationName}"
            editable="true"
        />
        <Label
            text="{i18n>srnOfWebIEPF5}"
            required="true"
        />
        <Input
            value="{viewModel>/SrnOfWebIEPF5}"
            editable="true"
        />
        <Label
            text="{i18n>srnForEVerification}"
            required="true"
        />
        <Input
            value="{viewModel>/SRNForEVerification}"
            editable="true"
        />
        <Label
            text="{i18n>dateOfFilingOfIEPF5}"
            required="true"
        />
        <Input
            value="{viewModel>/DateOfFilingOfIEPF5}"
            editable="true"
        />
        <Label
            text="{i18n>status}"
            required="true"
        />
        <ComboBox
            selectedKey="{viewModel>/Status}"
            items="{/F4_UploadTypeSet}"
            editable="true"
        >
            <core:Item
                key="{UPLOAD_TYPE}"
                text="{UPLOAD_TYPE_TEXT}"
            />
        </ComboBox>
    </f:SimpleForm>
</core:FragmentDefinition>
