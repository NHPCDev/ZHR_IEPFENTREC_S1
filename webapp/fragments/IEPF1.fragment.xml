<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <Table
        id="idIEPF1Table"
        items="{viewModel>/IEPF1}"
        growing="true"
        growingThreshold="20"
        width="100%"
        mode="MultiSelect"
        autoPopinMode="true"
        alternateRowColors="true"
        sticky="ColumnHeaders,HeaderToolbar,InfoToolbar"
        updateFinished="onIEPF1UpdateFinish"
    >
        <headerToolbar>
            <OverflowToolbar>
                <Title
                    id="idIEPF1Title"
                    text="{i18n>IEPF1}"
                />
                <ToolbarSpacer />
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="{i18n>sno}" />
            </Column>

            <Column>
                <Text text="{i18n>dividendType}" />
            </Column>

            <Column>
                <Text text="{i18n>financialYear}" />
            </Column>

            <Column>
                <Text text="{i18n>amount}" />
            </Column>
        </columns>
        <items>
            <ColumnListItem
                type="Inactive"
                press="onListItemPress"
            >
                <cells>
                    <Text text="{viewModel>Sno}" />
                    <Text text="{viewModel>DividendType}" />
                    <Text text="{viewModel>FinancialYear}" />
                    <Text text="{viewModel>Amount}" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
